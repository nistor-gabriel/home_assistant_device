{
  "@template": {
    "availability_topic": "device/%(device_id)s/status",
    "payload_available": "online",
    "payload_not_available": "offline",
    "optimistic": false,
    "qos": 1,
    "retain": false
  },
  "homeassistant/switch/%(device_id)s/disabledlowwatchdog/config": {
    "name": "Disabled Low Watchdog",
    "object_id": "%(device_id)s_disabledlowwatchdog",
    "unique_id": "%(device_id)s_disabledlowwatchdog",
    "state_topic": "device/%(device_id)s/disabledlowwatchdog",
    "command_topic": "device/%(device_id)s/disabledlowwatchdog/set",
    "entity_category": "config",
    "payload_on": "ON",
    "payload_off": "OFF",
    "state_on": "ON",
    "state_off": "OFF"
  },
  "homeassistant/switch/%(device_id)s/disabledhighwatchdog/config": {
    "name": "Disabled High Watchdog",
    "object_id": "%(device_id)s_disabledhighwatchdog",
    "unique_id": "%(device_id)s_disabledhighwatchdog",
    "state_topic": "device/%(device_id)s/disabledhighwatchdog",
    "command_topic": "device/%(device_id)s/disabledhighwatchdog/set",
    "entity_category": "config",
    "payload_on": "ON",
    "payload_off": "OFF",
    "state_on": "ON",
    "state_off": "OFF"
  },
  "homeassistant/number/%(device_id)s/offhighpressure/config": {
    "name": "Off High Pressure",
    "object_id": "%(device_id)s_offhighpressure",
    "unique_id": "%(device_id)s_offhighpressure",
    "state_topic": "device/%(device_id)s/offhighpressure",
    "command_topic": "device/%(device_id)s/offhighpressure/set",
    "entity_category": "config",
    "icon": "mdi:gauge-low",
    "min": 0,
    "max": 10,
    "step": 0.1,
    "mode": "box",
    "unit_of_measurement": "bar"
  },
  "homeassistant/number/%(device_id)s/offhighperiod/config": {
    "name": "Off High Period",
    "object_id": "%(device_id)s_offhighperiod",
    "unique_id": "%(device_id)s_offhighperiod",
    "state_topic": "device/%(device_id)s/offhighperiod",
    "command_topic": "device/%(device_id)s/offhighperiod/set",
    "entity_category": "config",
    "icon": "mdi:clock-fast",
    "min": "%(interval_update_pressure)s",
    "max": 120,
    "step": "%(interval_update_pressure)s",
    "mode": "box",
    "unit_of_measurement": "sec"
  },
  "homeassistant/number/%(device_id)s/offlowpressure/config": {
    "name": "Off Low Pressure",
    "object_id": "%(device_id)s_offlowpressure",
    "unique_id": "%(device_id)s_offlowpressure",
    "state_topic": "device/%(device_id)s/offlowpressure",
    "command_topic": "device/%(device_id)s/offlowpressure/set",
    "entity_category": "config",
    "icon": "mdi:gauge-full",
    "min": 0,
    "max": 10,
    "step": 0.1,
    "mode": "box",
    "unit_of_measurement": "bar"
  },
  "homeassistant/number/%(device_id)s/offlowstartperiod/config": {
    "name": "Off Low Start Period",
    "object_id": "%(device_id)s_offlowstartperiod",
    "unique_id": "%(device_id)s_offlowstartperiod",
    "state_topic": "device/%(device_id)s/offlowstartperiod",
    "command_topic": "device/%(device_id)s/offlowstartperiod/set",
    "entity_category": "config",
    "icon": "mdi:clock-end",
    "min": "%(interval_update_pressure)s",
    "max": 120,
    "step": "%(interval_update_pressure)s",
    "mode": "box",
    "unit_of_measurement": "sec"
  },
  "homeassistant/number/%(device_id)s/offlowperiod/config": {
    "name": "Off Low Period",
    "object_id": "%(device_id)s_offlowperiod",
    "unique_id": "%(device_id)s_offlowperiod",
    "state_topic": "device/%(device_id)s/offlowperiod",
    "command_topic": "device/%(device_id)s/offlowperiod/set",
    "entity_category": "config",
    "icon": "mdi:clock-fast",
    "min": "%(interval_update_pressure)s",
    "max": 120,
    "step": "%(interval_update_pressure)s",
    "mode": "box",
    "unit_of_measurement": "sec"
  },
  "homeassistant/sensor/%(device_id)s/pressure/config": {
    "name": "Pressure",
    "state_topic": "device/%(device_id)s/pressure",
    "device_class": "pressure",
    "unique_id": "%(device_id)s_pressure",
    "object_id": "%(device_id)s_pressure",
    "icon": "mdi:balloon",
    "unit_of_measurement": "bar"
  }
}